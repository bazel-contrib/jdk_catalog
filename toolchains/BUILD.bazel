load(
    "@rules_java//toolchains:default_java_toolchain.bzl",
    "DEFAULT_TOOLCHAIN_CONFIGURATION",
    "default_java_toolchain",
)
load(
    "@rules_java//toolchains:java_toolchain_alias.bzl",
    "java_runtime_version_alias",
)
load("//jdk:repositories.bzl", "JDK25_CONFIGS", "JDK27_CONFIGS")

package(default_visibility = ["//visibility:public"])

_JDK_VERSIONS = [
    "25",
    "27",
]

_JDK_CONFIGS = JDK25_CONFIGS + JDK27_CONFIGS

[java_runtime_version_alias(
    name = "remotejdk_" + version,
    runtime_version = "remotejdk_" + version,
) for version in _JDK_VERSIONS]

[default_java_toolchain(
    name = "toolchain_jdk_" + version,
    configuration = DEFAULT_TOOLCHAIN_CONFIGURATION,
    java_runtime = ":remotejdk_" + version,
    source_version = version,
    target_version = version,
) for version in _JDK_VERSIONS]

# Match remote_java_repository's prefixed and numeric runtime selectors.
[config_setting(
    name = "prefix_version_setting_" + version,
    values = {"java_runtime_version": "remotejdk_" + version},
    visibility = ["//visibility:private"],
) for version in _JDK_VERSIONS]

[config_setting(
    name = "version_setting_" + version,
    values = {"java_runtime_version": version},
    visibility = ["//visibility:private"],
) for version in _JDK_VERSIONS]

[alias(
    name = "version_or_prefix_version_setting_" + version,
    actual = select({
        ":version_setting_" + version: ":version_setting_" + version,
        "//conditions:default": ":prefix_version_setting_" + version,
    }),
    visibility = ["//visibility:private"],
) for version in _JDK_VERSIONS]

# Root consumers register compile, runtime and bootstrap toolchains together.
# Derive platform constraints from the same records that supply the archives.
[toolchain(
    name = cfg.name + "_runtime_toolchain",
    target_compatible_with = cfg.target_compatible_with,
    target_settings = [":version_or_prefix_version_setting_" + cfg.version],
    toolchain = "@" + cfg.name + "//:jdk",
    toolchain_type = "@bazel_tools//tools/jdk:runtime_toolchain_type",
) for cfg in _JDK_CONFIGS]

# Execution constraints avoid fetching other architectures for bootstrapping.
[toolchain(
    name = cfg.name + "_bootstrap_runtime_toolchain",
    exec_compatible_with = cfg.target_compatible_with,
    target_settings = [":version_or_prefix_version_setting_" + cfg.version],
    toolchain = "@" + cfg.name + "//:jdk",
    toolchain_type = "@bazel_tools//tools/jdk:bootstrap_runtime_toolchain_type",
) for cfg in _JDK_CONFIGS]
