# Use Bazel's documentation extractor without adding a generator dependency.
starlark_doc_extract(
    name = "extensions",
    src = "//jdk:extensions.bzl",
    symbol_names = [
        "jdks",
        "non_lts_jdks",
    ],
    deps = [
        "//jdk:catalog.bzl",
        "//jdk:repositories.bzl",
        "@bazel_tools//tools/build_defs/repo:cache.bzl",
        "@bazel_tools//tools/build_defs/repo:http.bzl",
        "@bazel_tools//tools/build_defs/repo:utils.bzl",
        "@rules_java//toolchains:bzl_srcs",
    ],
)

starlark_doc_extract(
    name = "repositories",
    src = "//jdk:repositories.bzl",
    symbol_names = [
        "remote_jdk25_repos",
        "remote_jdk27_repos",
    ],
    deps = [
        "//jdk:catalog.bzl",
        "@bazel_tools//tools/build_defs/repo:cache.bzl",
        "@bazel_tools//tools/build_defs/repo:http.bzl",
        "@bazel_tools//tools/build_defs/repo:utils.bzl",
        "@rules_java//toolchains:bzl_srcs",
    ],
)
