{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "matchManagers": ["bazel-module"],
      "enabled": false
    },
    {
      "matchDepNames": ["bazel-contrib/.github", "bazel-contrib/publish-to-bcr"],
      "pinDigests": false
    }
  ]
}
