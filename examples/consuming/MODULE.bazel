module(
    name = "consuming_example",
    version = "0.0.0",
)

bazel_dep(name = "rules_java", version = "9.9.0")
bazel_dep(name = "jdk_catalog", version = "0.1.2")

# Test this checkout as a dependency of a separate module. After BCR publication,
# consumers can use bazel_dep without an override.
local_path_override(
    module_name = "jdk_catalog",
    path = "../..",
)

# Prefer catalog runtimes over upstream rules_java runtime registrations.
register_toolchains("@jdk_catalog//toolchains:all")
